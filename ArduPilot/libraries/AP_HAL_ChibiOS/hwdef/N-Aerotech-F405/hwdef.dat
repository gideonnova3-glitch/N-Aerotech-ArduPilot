# ==============================================================================
# Hardware Definition: N-Aerotech-F405 (Clean Core Architecture)
# ==============================================================================

# Mewarisi fondasi murni chip STM32F4 resmi dari ArduPilot (Bukan board orang lain)
include hwdef/scripts/stm32f4.dat

BOARD_NAME N-Aerotech-F405
AP_VERSION_NAME N-Aerotech-F405-V1.0

# Alokasi Flash untuk STM32F405 (1MB)
flash size 1024
FLASH_RESERVE_START_KB 16

# Konfigurasi USB VCP Bawaan
define HAL_USE_USB TRUE
USB_DRIVER USBD1
USB_CDC_LINE_CODING_NOTIFICATIONS TRUE

# ------------------------------------------------------------------------------
# PEMETAAN PERANGKAT KERAS (N-Aerotech-F405 Custom Layout)
# ------------------------------------------------------------------------------

# SPI Bus Declarations
SPI 1 PA5 PA6 PA7
SPI 2 PB13 PB14 PB15
SPI 3 PC10 PC11 PC12

# SPI Devices & Sensors Mapping
SPIDEV imu1  SPI1 DEVID1 PA4  SPI_DEVICE_IMU  8000000
SPIDEV flash SPI2 DEVID2 PB12 SPI_DEVICE_OSD  8000000
SPIDEV osd   SPI3 DEVID3 PC8  SPI_DEVICE_OSD  4000000

# I2C Bus: Barometer (SPL06-001)
I2C 1 PB6 PB7

# UART / Serial Ports
SERIAL_ORDER standard GPS1 telem1 debug
UART 1 PA9 PA10
UART 2 PA2 PA3
UART 3 PB10 PB11

# PWM Motor Outputs
PWM_MAIN 1 PA0
PWM_MAIN 2 PA1
PWM_MAIN 3 PB0
PWM_MAIN 4 PB1

# Analog Voltage & Current Sensors
PC0 BATT_VOLT_PIN ADC1 ANALOG
PC1 BATT_CURR_PIN ADC1 ANALOG

# Status LEDs
PC13 LED_GREEN OUTPUT
PC14 LED_RED OUTPUT
PC15 LED_BLUE OUTPUT
LED_LABEL 1 GREEN
LED_LABEL 2 RED
LED_LABEL 3 BLUE

# Opsi Konfigurasi Build
AP_BOOTLOADER_FLASHING_ENABLED 0
FLASH_BOOTLOADER 0
