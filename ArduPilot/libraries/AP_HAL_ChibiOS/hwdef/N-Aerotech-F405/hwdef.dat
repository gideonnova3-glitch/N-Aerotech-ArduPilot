# ==============================================================================
# Hardware Definition: N-Aerotech-F405 (Complete Clean & Secure Build)
# ==============================================================================

include ../MatekF405/hwdef.dat

BOARD_NAME N-Aerotech-F405
AP_VERSION_NAME N-Aerotech-F405-V1.0

# ------------------------------------------------------------------------------
# PEMBERSIHAN TOTAL (UNDEF): Menghilangkan seluruh potensi benturan pin 
# dari board induk MatekF405 yang tidak sesuai dengan skematik kustom kita
# ------------------------------------------------------------------------------
undef PA0
undef PA1
undef PA2
undef PA3
undef PA4
undef PA5
undef PA6
undef PA7
undef PA8
undef PA9
undef PA10
undef PB0
undef PB1
undef PB6
undef PB7
undef PB10
undef PB11
undef PB12
undef PB13
undef PB14
undef PB15
undef PC0
undef PC1
undef PC8
undef PC10
undef PC11
undef PC12
undef PC13
undef PC14
undef PC15

# ------------------------------------------------------------------------------
# PEMETAAN ULANG KUSTOM (N-Aerotech-F405 Hardware Layout)
# ------------------------------------------------------------------------------

# SPI Bus Declarations
SPI 1 PA5 PA6 PA7
SPI 2 PB13 PB14 PB15
SPI 3 PC10 PC11 PC12

# SPI Devices & Sensors Mapping
SPIDEV imu1  SPI1 DEVID1 PA4  SPI_DEVICE_IMU  8000000
SPIDEV flash SPI2 DEVID2 PB12 SPI_DEVICE_OSD  8000000
SPIDEV osd   SPI3 DEVID3 PC8  SPI_DEVICE_OSD  4000000

# I2C Bus: Barometer (SPL06-001)
I2C 1 PB6 PB7

# UART / Serial Ports
SERIAL_ORDER standard GPS1 telem1 debug serial4
UART 1 PA9 PA10
UART 2 PA2 PA3
UART 3 PB10 PB11
UART 4 PC10 PC11

# PWM Motor Outputs
PWM_MAIN 1 PA0
PWM_MAIN 2 PA1
PWM_MAIN 3 PB0
PWM_MAIN 4 PB1

# Analog Voltage & Current Sensors
PC0 BATT_VOLT_PIN ADC1 ANALOG
PC1 BATT_CURR_PIN ADC1 ANALOG

# Status LEDs
PC13 LED_GREEN OUTPUT
PC14 LED_RED OUTPUT
PC15 LED_BLUE OUTPUT
LED_LABEL 1 GREEN
LED_LABEL 2 RED
LED_LABEL 3 BLUE

# Konfigurasi Build & Bootloader
AP_BOOTLOADER_FLASHING_ENABLED 0
FLASH_BOOTLOADER 0
```[cite: 1]
