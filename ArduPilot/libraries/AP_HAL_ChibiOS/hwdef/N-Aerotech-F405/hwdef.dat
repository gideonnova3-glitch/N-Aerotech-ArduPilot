# ==============================================================================
# Hardware Definition: N-Aerotech-F405 (Clean & Validated Standard)
# ==============================================================================

include ../MatekF405/hwdef.dat

BOARD_NAME N-Aerotech-F405
AP_VERSION_NAME N-Aerotech-F405-V1.0

# Redefinisi & Petakan Ulang Pin SPI1 (IMU ICM-42688-P) secara eksplisit
PA5 SPI1_SCK SPI_DEVICE_IMU
PA6 SPI1_MISO SPI_DEVICE_IMU
PA7 SPI1_MOSI SPI_DEVICE_IMU
SPIDEV imu1 SPI1 DEVID1 PA4

# Redefinisi & Petakan Ulang Pin SPI2 (Flash W25Q128)
PB13 SPI2_SCK SPI_DEVICE_OSD
PB14 SPI2_MISO SPI_DEVICE_OSD
PB15 SPI2_MOSI SPI_DEVICE_OSD
SPIDEV flash SPI2 DEVID2 PB12

# Redefinisi & Petakan Ulang Pin SPI3 (OSD AT7456E)
PC10 SPI3_SCK SPI_DEVICE_OSD
PC11 SPI3_MISO SPI_DEVICE_OSD
PC12 SPI3_MOSI SPI_DEVICE_OSD
SPIDEV osd SPI3 DEVID3 PC8

# I2C Bus: Barometer (SPL06-001)
I2C 1 PB6 PB7

# UART / Serial Ports
SERIAL_ORDER standard GPS1 telem1 debug serial4
UART 1 PA9 PA10
UART 2 PA2 PA3
UART 3 PB10 PB11
UART 4 PC10 PC11

# PWM Motor Outputs
PWM_MAIN 1 PA0
PWM_MAIN 2 PA1
PWM_MAIN 3 PB0
PWM_MAIN 4 PB1

# Analog Voltage & Current Sensors
PC0 BATT_VOLT_PIN ADC1 ANALOG
PC1 BATT_CURR_PIN ADC1 ANALOG

# Status LEDs
PC13 LED_GREEN OUTPUT
PC14 LED_RED OUTPUT
PC15 LED_BLUE OUTPUT
LED_LABEL 1 GREEN
LED_LABEL 2 RED
LED_LABEL 3 BLUE

# Konfigurasi Build & Bootloader
AP_BOOTLOADER_FLASHING_ENABLED 0
FLASH_BOOTLOADER 0
