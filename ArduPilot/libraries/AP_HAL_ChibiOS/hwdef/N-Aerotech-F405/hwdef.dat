# ==============================================================================
# Hardware Definition: N-Aerotech-F405 (Pure Independent Production)
# ==============================================================================

MCU STM32F4 STM32F405
BOARD_NAME N-Aerotech-F405
define HAL_BOARD_CLASS HAL_BOARD_CHIBIOS
AP_VERSION_NAME N-Aerotech-F405-V1.0

# Flash & Memory Map (1MB Flash)
FLASH_SIZE_KB 1024
env AP_HAL_CHIBIOS_USE_LEGACY_PLI FALSE

# Clock Configuration (External 8MHz Crystal)
CLK HSE 8000000
CLK_SYSCLK 168000000
CLK_HSIRC 16000000

# SPI1: IMU Utama (ICM-42688-P)
SPI 1 PA5 PA6 PA7 SPI_DEVICE_IMU
SPIDEV imu1 SPI1 DEVID1 PA4

# SPI2: Flash Memory (W25Q128)
SPI 2 PB13 PB14 PB15 SPI_DEVICE_OSD
SPIDEV flash SPI2 DEVID2 PB12

# SPI3: OSD (AT7456E)
SPI 3 PC10 PC11 PC12 SPI_DEVICE_OSD
SPIDEV osd SPI3 DEVID3 PC8

# I2C Bus: Barometer (SPL06-001)
I2C 1 PB6 PB7

# UART / Serial Ports
SERIAL_ORDER standard GPS1 telem1 debug serial4
UART 1 PA9 PA10
UART 2 PA2 PA3
UART 3 PB10 PB11
UART 4 PC10 PC11

# PWM Motor Outputs
PWM_MAIN 1 PA0
PWM_MAIN 2 PA1
PWM_MAIN 3 PB0
PWM_MAIN 4 PB1

# Analog Voltage & Current Sensors
PC0 BATT_VOLT_PIN ADC1 ANALOG
PC1 BATT_CURR_PIN ADC1 ANALOG

# Status LEDs
PC13 LED_GREEN OUTPUT
PC14 LED_RED OUTPUT
PC15 LED_BLUE OUTPUT
LED_LABEL 1 GREEN
LED_LABEL 2 RED
LED_LABEL 3 BLUE

# Disable bootloader checks for custom build
AP_BOOTLOADER_FLASHING_ENABLED 0
FLASH_BOOTLOADER 0
